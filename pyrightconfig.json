// AUTHORITATIVE analysis config.
//
// Pylance reads this file at the workspace root and it OVERRIDES the
// python.analysis.* path settings in .vscode/settings.json — include, exclude,
// ignore, stubPath, extraPaths, and typeCheckingMode all come from here.
//
// Why it exists: settings.json exclude/ignore globs did not stop Pylance from
// reporting ~110k diagnostics inside Jools.extension/typings (11,639 .pyi files).
// "include" is not a filter that something else can defeat — it is the definition
// of what gets analyzed. Anything not listed is never reported, though it is
// still read for imports and completions.
//
// Add a new top-level source folder to "include" or Pylance will not check it.
{
  "include": [
    "Jools.extension/Jools.tab",
    "Jools.extension/bin",
    "Jools.extension/hooks",
    "tools"
  ],

  // Specifying "exclude" REPLACES pyright's defaults rather than extending them,
  // so the three built-ins must be restated. "**/.*" covers every dot-directory
  // (.git, .venv, .vscode, .obsidian) and is the one Pylance warns about if absent.
  "exclude": [
    "**/.*",
    "**/node_modules",
    "**/__pycache__",
    "**/typings",
    "**/_deprecated"
  ],

  "ignore": [
    "**/.*",
    "**/__pycache__",
    "**/typings",
    "**/_deprecated"
  ],

  // Deepest folder directly containing Autodesk/, System/, clr.pyi, wpf.pyi.
  "stubPath": "Jools.extension/typings/RVT 25",

  // Real source only. Never put typings here — that promotes stubs to user code.
  "extraPaths": [
    "C:/Users/rjohnston/AppData/Roaming/pyRevit-Master/pyrevitlib",
    "C:/Users/rjohnston/AppData/Roaming/pyRevit-Master/site-packages"
  ],

  // Matches pyRevit's CPY3123 engine — the interpreter that runs `#! python3`.
  "pythonVersion": "3.12",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",

  // Unresolvable .NET / Revit imports are silenced.
  //
  // The three rules marked [.NET] below are OFF because the Revit stubs cannot
  // model .NET semantics, not because the code is wrong. Verified against
  // Revit 2026 RevitAPI.xml with tools/revit_api.py:
  //   reportOperatorIssue        XYZ defines op_Subtraction/op_Multiply, which
  //                              the stubs do not expose as __sub__/__mul__.
  //   reportGeneralTypeIssues    Autodesk.Revit.Exceptions.* are real exception
  //                              types at runtime but do not subclass
  //                              BaseException in the stubs, so `except` on them
  //                              is flagged.
  //   reportInvalidTypeArguments pythonnet resolves generics by subscript, e.g.
  //                              List[DB.ElementId](). The stubs declare List
  //                              as non-generic.
  // 19 of 21 tool scripts hit at least one of these. Do NOT "fix" the code to
  // satisfy them - the code is correct and the analyzer is not.
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportAttributeAccessIssue": "none",
  "reportOptionalMemberAccess": "none",
  "reportOptionalSubscript": "none",
  "reportOptionalCall": "none",
  "reportOptionalIterable": "none",
  "reportOptionalOperand": "none",
  "reportOptionalContextManager": "none",
  "reportIndexIssue": "none",
  "reportArgumentType": "none",
  "reportCallIssue": "none",
  "reportUninitializedInstanceVariable": "none",
  "reportIncompatibleMethodOverride": "none",
  "reportOperatorIssue": "none",
  "reportGeneralTypeIssues": "none",
  "reportInvalidTypeArguments": "none",

  // Real bugs worth seeing.
  "reportUndefinedVariable": "error",
  "reportUnboundVariable": "error",
  "reportSelfClsParameterName": "error",
  "reportRedeclaration": "warning",
  "reportUnusedImport": "warning",
  "reportUnusedVariable": "warning",
  "reportUnusedExpression": "warning",
  "reportUnreachable": "warning",
  "reportAssertAlwaysTrue": "warning"
}
