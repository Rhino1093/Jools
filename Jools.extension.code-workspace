{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// Python analysis is configured in .vscode/settings.json so there is one
		// source of truth. Workspace-file settings override folder settings, so
		// do NOT add python.* keys here — they will silently win and diverge.
		"betterAlign.surroundSpace": {
			"colon": [
				0,
				1
			],
			"assignment": [
				1,
				1
			],
			"arrow": [
				1,
				1
			],
			"comment": 2
		}
	},
	"extensions": {
		"recommendations": [
			"ms-python.python",
			"ms-python.vscode-pylance",
			"redhat.vscode-yaml"
		]
	}
}
