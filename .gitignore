# dependencies & stubs
**/typings/
*.pyi

# python
__pycache__/
*.py[cod]
*$py.class
.venv/

# ide configurations
# Shared analysis config and tasks ARE tracked so a fresh clone still detects
# issues; only per-machine state is ignored. See CLAUDE.md 8.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# secrets & logs
.env
*.log

# os files
.DS_Store
Thumbs.db
